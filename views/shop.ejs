<%- include('./partials/header') %>

<% if (success.length > 0) { %>
    <div class="fixed top-5 left-1/2 -translate-x-1/2 z-50 p-3 rounded-xl bg-[#263A33] shadow-lg">
        <span class="text-white text-sm font-medium">
            <%= success %>
        </span>
    </div>
<% } %>

<div class="min-h-screen bg-[#F7F4EE] text-[#242824] px-6 md:px-10 lg:px-16 py-12">

    <!-- Page Heading -->
    <div class="mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] text-[#9A7B59] uppercase mb-3">
            Everyday Carry · New Collection
        </p>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-[#263A33]">
            Carry your world.
        </h1>
        <p class="text-[#77796F] mt-3 text-sm">
            Everyday essentials, designed for wherever life takes you.
        </p>
    </div>

    <div class="flex flex-col lg:flex-row items-start gap-10">

        <!-- Sidebar -->
        <aside class="w-full lg:w-[220px] shrink-0">

            <!-- Sort By -->
            <div class="bg-white rounded-xl p-5 border border-[#E8E2D8]">
                <h3 class="text-sm font-semibold text-[#263A33] mb-3">
                    Sort by
                </h3>

                <form action="/shop" method="GET">
                    <select
                        class="w-full border border-[#E5DED2] bg-[#F7F4EE] rounded-lg px-3 py-2 text-sm outline-none focus:border-[#263A33]"
                        name="sortby"
                        onchange="this.form.submit()"
                    >
                        <option value="popular">Popular</option>
                        <option value="byprice">Price: Low to High</option>
                        <option value="newest">Newest</option>
                    </select>
                </form>
            </div>

            <!-- Categories -->
            <div class="mt-8">
                <h3 class="text-xs font-semibold tracking-widest uppercase text-[#999387] mb-4">
                    Collections
                </h3>

                <nav class="flex flex-col gap-1">
                    <a
                        class="rounded-lg px-3 py-2 bg-[#263A33] text-white text-sm font-medium"
                        href="/shop"
                    >
                        All Products
                    </a>

                    <a
                        class="rounded-lg px-3 py-2 text-sm text-[#555B53] hover:bg-white hover:text-[#263A33] transition"
                        href="/shop?collection=new"
                    >
                        New Collection
                    </a>

                    <a
                        class="rounded-lg px-3 py-2 text-sm text-[#555B53] hover:bg-white hover:text-[#263A33] transition"
                        href="/shop?discounted=true"
                    >
                        Discounted Products
                    </a>
                </nav>
            </div>

            <!-- Filters -->
            <div class="mt-8 bg-white rounded-xl p-5 border border-[#E8E2D8]">
                <h3 class="text-sm font-semibold text-[#263A33] mb-4">
                    Filter by
                </h3>

                <div class="flex flex-col gap-3 text-sm text-[#555B53]">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            class="accent-[#263A33]"
                            onchange="window.location.href='/shop?availability=available'"
                        >
                        Availability
                    </label>

                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            class="accent-[#263A33]"
                            onchange="window.location.href='/shop?discounted=true'"
                        >
                        Discount
                    </label>
                </div>
            </div>

        </aside>

        <!-- Products Section -->
        <main class="flex-1 min-w-0 w-full">

            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-semibold text-[#263A33]">
                    All bags
                </h2>

                <p class="text-sm text-[#85867D]">
                    <%= products.length %> products
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-5">

                <% products.forEach(function(product) { %>

                    <div class="group overflow-hidden rounded-xl bg-white border border-[#EAE5DC] transition duration-300 hover:-translate-y-1 hover:shadow-lg">

                        <!-- Product Image -->
                        <div class="w-full h-56 flex items-center justify-center overflow-hidden bg-[<%= product.bgcolor %>]">
                            <img
                                class="h-[12rem] max-w-[90%] object-contain transition duration-300 group-hover:scale-105"
                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                alt="<%= product.name %>"
                            >
                        </div>

                        <!-- Product Details -->
                        <div class="p-4 flex items-center justify-between gap-3">

                            <div class="min-w-0">
                                <h3 class="text-sm font-medium text-[#263A33] truncate">
                                    <%= product.name %>
                                </h3>

                                <h4 class="mt-1 text-base font-semibold text-[#263A33]">
                                    Rs <%= product.price %>
                                </h4>

                                <% if (product.discount > 0) { %>
                                    <p class="mt-1 text-xs text-[#9A7B59]">
                                        Rs <%= product.discount %> off
                                    </p>
                                <% } %>
                            </div>

                            <a
                                class="shrink-0 w-9 h-9 flex items-center justify-center rounded-full bg-[#263A33] text-white hover:bg-[#3B5548] transition"
                                href="/addtocart/<%= product._id %>"
                                aria-label="Add <%= product.name %> to cart"
                            >
                                <i class="ri-add-line text-lg"></i>
                            </a>

                        </div>
                    </div>

                <% }) %>

            </div>
        </main>
    </div>
</div>

<%- include('./partials/footer') %>
